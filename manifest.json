{
  "manifest_version": 3,
  "name": "Beyond Full Art",
  "version": "0.1.1",
  "description": "A Better D&D Beyond Experience For Players - Better Character Art Experience, Added Character Journals, and More!",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/settings.html"
  },
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "https://character-service.dndbeyond.com/character/v5/character*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.dndbeyond.com/characters/*"],
      "js": ["content/character-sheet-entry.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.dndbeyond.com/campaigns/*"],
      "js": ["content/card-portraits-entry.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.dndbeyond.com/characters*"],
      "js": ["content/card-portraits-entry.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.dndbeyond.com/characters*"],
      "js": ["content/character-deletion-entry.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.dndbeyond.com/characters*"],
      "js": ["content/character-deletion-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.dndbeyond.com/characters*"],
      "js": ["content/character-copy-entry.js"],
      "run_at": "document_start"
    }
  ]
}

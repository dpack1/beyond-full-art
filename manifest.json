{
  "manifest_version": 3,
  "name": "Beyond Full Art",
  "version": "0.1.0",
  "description": "Open D&D Beyond character sidebar portraits in an accessible fullscreen viewer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/settings.html"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.dndbeyond.com/characters/*"],
      "js": ["content/character-sheet-entry.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.dndbeyond.com/campaigns/*"],
      "js": ["content/campaigns-entry.js"],
      "run_at": "document_idle"
    }
  ]
}
